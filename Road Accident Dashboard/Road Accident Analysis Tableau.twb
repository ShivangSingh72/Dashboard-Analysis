      <aliases enabled='yes' />
      <column caption='Accident Severity' datatype='string' name='[Accident_Severity]' role='dimension' type='nominal' />
      <column aggregation='Sum' caption='Year of Accident Date' datatype='integer' name='[Calculation_1121797077704704]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='YEAR([Accident Date])' />
      </column>
      <column caption='Current Year Accidents' datatype='integer' name='[Calculation_1121797327921156]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT (IF &#13;&#10;YEAR([Accident Date]) = [Parameters].[Parameter 1121797078700033]&#13;&#10;THEN&#13;&#10;[Index]&#13;&#10;END)' />
      </column>
      <column caption='Year on Year Accidents' datatype='real' default-format='*↑0.00%;↓0.00%' name='[Calculation_1121797331439626]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_1121797327921156] - [Current Year Accidents (copy)_1121797330763782])/[Current Year Accidents (copy)_1121797330763782]' />
      </column>
      <column caption='Current Year Cassualties' datatype='integer' name='[Calculation_1121797338460173]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM( IF YEAR([Accident Date])=[Parameters].[Parameter 1121797078700033]&#13;&#10;THEN[Number_of_Casualties] END)' />
      </column>
      <column caption='Current Year Fatal Cassualties' datatype='integer' name='[Calculation_1121797340991504]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IF [Accident_Severity] = &apos;Fatal&apos; and &#13;&#10;YEAR([Accident Date]) = [Parameters].[Parameter 1121797078700033]&#13;&#10;THEN [Number_of_Casualties] END)' />
      </column>
      <column caption='Accident Severity Filter' datatype='boolean' name='[Calculation_1121797377732634]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 1121797376331801]=[Accident_Severity]&#13;&#10;OR [Parameters].[Parameter 1121797376331801]=&apos;All&apos;' />
      </column>
      <column caption='Previous Year Accident' datatype='integer' name='[Current Year Accidents (copy)_1121797330763782]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT (IF &#13;&#10;YEAR([Accident Date]) = [Parameters].[Current Year (copy)_1121797079224322]&#13;&#10;THEN&#13;&#10;[Index]&#13;&#10;END)' />
      </column>
      <column caption='Previous Year Cassualties ' datatype='integer' name='[Current Year Cassualties (copy)_1121797339676686]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM( IF YEAR([Accident Date])=[Parameters].[Current Year (copy)_1121797079224322]&#13;&#10;THEN[Number_of_Casualties] END)' />
      </column>
      <column caption='Previous Year Fatal Cassualties ' datatype='integer' name='[Current Year Fatal Cassualties (copy)_1121797341503505]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IF [Accident_Severity] = &apos;Fatal&apos; and &#13;&#10;YEAR([Accident Date]) = [Parameters].[Current Year (copy)_1121797079224322]&#13;&#10;THEN [Number_of_Casualties] END)' />
      </column>
      <column caption='Current Year Serious Cassualties ' datatype='integer' name='[Current Year Fatal Cassualties (copy)_1121797342232595]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IF [Accident_Severity] = &apos;Serious&apos; and &#13;&#10;YEAR([Accident Date]) = [Parameters].[Parameter 1121797078700033]&#13;&#10;THEN [Number_of_Casualties] END)' />
      </column>
      <column caption='Current Year Slight Cassualties ' datatype='integer' name='[Current Year Serious Cassualties  (copy)_1121797344280598]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IF [Accident_Severity] = &apos;Slight&apos; and &#13;&#10;YEAR([Accident Date]) = [Parameters].[Parameter 1121797078700033]&#13;&#10;THEN [Number_of_Casualties] END)' />
